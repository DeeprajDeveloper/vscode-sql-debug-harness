{
  "name": "sp-debug",
  "displayName": "MS-SQL Debug Script Transformer",
  "description": "Generate safe debug scripts and structural inventory reports from T-SQL stored procedures.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeeprajDeveloper/mssql-sp-debug-scripter/tree/main"
  },
  "license": "MIT",
  "version": "1.1.0",
  "publisher": "DeeprajAdhikary",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "images/extension-logo.png",
  "categories": ["Other", "Programming Languages", "SQL", "SQL Debugging"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spDebug.generate",
        "title": "MS-SQL Debug Scripter: Generate Transformed Debug Script",
        "icon": "$(debug-alt)"
      },
      {
        "command": "spDebug.inventory",
        "title": "MS-SQL Debug Scripter: Generate Structural Keyword Report",
        "icon": "$(list-flat)"
      },
      {
        "command": "spDebug.verifySetup",
        "title": "MS-SQL Debug Scripter: Verify Python Setup",
        "icon": "$(check-all)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "spDebug.generate",
          "when": "resourceExtname == .sql",
          "group": "7_modification@1"
        },
        {
          "command": "spDebug.inventory",
          "when": "resourceExtname == .sql",
          "group": "7_modification@2"
        }
      ],
      "editor/context": [
        {
          "command": "spDebug.generate",
          "when": "resourceLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "spDebug.inventory",
          "when": "resourceLangId == sql",
          "group": "navigation@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "spDebug.generate",
          "when": "resourceLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "spDebug.inventory",
          "when": "resourceLangId == sql",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "MS-SQL Debug Scripter",
      "properties": {
        "spDebug.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable for sp-debug. Leave empty to try python3, python, and py (Windows)."
        },
        "spDebug.pipPackage": {
          "type": "string",
          "default": "mssql-sp-debug",
          "description": "PyPI package name shown in install hints (pip install <name>)."
        },
        "spDebug.preferWorkspaceDev": {
          "type": "boolean",
          "default": true,
          "description": "If this workspace contains tools/sp-debug, use that source when pip install is missing."
        },
        "spDebug.traceStyle": {
          "type": "string",
          "enum": ["raiserror", "print"],
          "default": "print",
          "description": "Trace line style for generated debug scripts (print or raiserror)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "mkdir -p dist && vsce package --out dist/sp-debug.vsix --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "2.32.0",
    "typescript": "^5.3.0"
  }
}
