{
  "name": "sql-sp-harness",
  "displayName": "SQL SP Harness",
  "description": "Generate safe T-SQL debug harness scripts and analyze stored procedures from VS Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeeprajDeveloper/vscode-sql-sp-harness"
  },
  "license": "MIT",
  "version": "2.0.0",
  "publisher": "DeeprajAdhikary",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "images/extension-logo.png",
  "categories": ["Other", "Programming Languages"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spDebug.generate",
        "title": "SQL SP Harness: Generate Debug Script",
        "icon": "$(debug-alt)"
      },
      {
        "command": "spDebug.analyze",
        "title": "SQL SP Harness: Analyze Procedure",
        "icon": "$(list-flat)"
      },
      {
        "command": "spDebug.verifySetup",
        "title": "SQL SP Harness: Verify Python Setup",
        "icon": "$(check-all)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "spDebug.generate",
          "when": "resourceExtname == .sql",
          "group": "7_modification@1"
        },
        {
          "command": "spDebug.analyze",
          "when": "resourceExtname == .sql",
          "group": "7_modification@2"
        }
      ],
      "editor/context": [
        {
          "command": "spDebug.generate",
          "when": "resourceLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "spDebug.analyze",
          "when": "resourceLangId == sql",
          "group": "navigation@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "spDebug.generate",
          "when": "resourceLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "spDebug.analyze",
          "when": "resourceLangId == sql",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "SQL SP Harness",
      "properties": {
        "spDebug.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable for sql-sp-harness. Leave empty to try python3, python, and py (Windows)."
        },
        "spDebug.pipPackage": {
          "type": "string",
          "default": "sql-sp-harness",
          "description": "PyPI package name shown in install hints (pip install <name>)."
        },
        "spDebug.traceStyle": {
          "type": "string",
          "enum": ["raiserror", "print"],
          "default": "print",
          "description": "Trace line style for generated debug scripts (print or raiserror)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "mkdir -p dist && vsce package --out dist/sql-sp-harness.vsix --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "2.32.0",
    "typescript": "^5.3.0"
  }
}
