{
  "name": "sql-debug-harness",
  "displayName": "SQL Debug Harness",
  "description": "Generate safe T-SQL debug harness scripts and analyze stored procedures from VS Code — no Python required.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeeprajDeveloper/vscode-sql-debug-harness"
  },
  "license": "MIT",
  "version": "0.0.5",
  "publisher": "DeeprajAdhikary",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "icon": "images/extension-logo.png",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "sql",
    "tsql",
    "sql-server",
    "stored-procedure",
    "debug-harness"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "bin": {
    "sql-debug-harness": "./out/cli.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sql-debug-harness",
          "title": "SQL Debug Harness",
          "icon": "images/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "sql-debug-harness": [
        {
          "id": "sqlSpHarness.sidebar",
          "name": "Workbench",
          "icon": "$(window)",
          "contextualTitle": "SQL Debug Harness"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sqlSpHarness.sidebar",
        "contents": "SQL Debug Harness is ready.\n\nUse **Actions** above, or open a `.sql` file and run Analyze / Generate.\n\n**Recent procedures** appear here after you analyze or debug.",
        "when": "sqlSpHarness.historyEmpty"
      }
    ],
    "commands": [
      {
        "command": "spDebug.generate",
        "title": "Generate Debug Script",
        "category": "SQL Debug Harness",
        "icon": "$(debug-alt)"
      },
      {
        "command": "spDebug.analyze",
        "title": "Analyze Procedure",
        "category": "SQL Debug Harness",
        "icon": "$(list-flat)"
      },
      {
        "command": "spDebug.openWorkbench",
        "title": "Open Workbench",
        "category": "SQL Debug Harness",
        "icon": "$(window)"
      },
      {
        "command": "spDebug.openInWorkbench",
        "title": "Open in Workbench",
        "category": "SQL Debug Harness",
        "icon": "$(window)"
      },
      {
        "command": "spDebug.configure",
        "title": "Configure Settings",
        "category": "SQL Debug Harness",
        "icon": "$(settings-gear)"
      },
      {
        "command": "spDebug.openSettings",
        "title": "Open Extension Settings",
        "category": "SQL Debug Harness",
        "icon": "$(settings)"
      },
      {
        "command": "spDebug.clearHistory",
        "title": "Clear Recent Procedures",
        "category": "SQL Debug Harness",
        "icon": "$(clear-all)"
      },
      {
        "command": "spDebug.toggleSidebar",
        "title": "Toggle Sidebar",
        "category": "SQL Debug Harness",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "spDebug.showHistory",
        "title": "Show Recent Procedures",
        "category": "SQL Debug Harness",
        "icon": "$(history)"
      }
    ],
    "submenus": [
      {
        "id": "spDebug.submenu",
        "label": "SQL Debug Harness",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "spDebug.openWorkbench",
          "when": "view == sqlSpHarness.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "spDebug.analyze",
          "when": "view == sqlSpHarness.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "spDebug.generate",
          "when": "view == sqlSpHarness.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "spDebug.clearHistory",
          "when": "view == sqlSpHarness.sidebar",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "spDebug.clearHistory",
          "when": "view == sqlSpHarness.sidebar && viewItem == historyGroup",
          "group": "inline@1"
        }
      ],
      "spDebug.submenu": [
        {
          "command": "spDebug.openWorkbench",
          "group": "1_run@0"
        },
        {
          "command": "spDebug.generate",
          "group": "1_run@1"
        },
        {
          "command": "spDebug.analyze",
          "group": "1_run@2"
        },
        {
          "command": "spDebug.configure",
          "group": "2_setup@1"
        },
        {
          "command": "spDebug.openSettings",
          "group": "2_setup@2"
        }
      ],
      "commandPalette": [
        {
          "command": "spDebug.openWorkbench"
        }
      ],
      "explorer/context": [
        {
          "command": "spDebug.openInWorkbench",
          "when": "resourceExtname == .sql",
          "group": "navigation@9"
        },
        {
          "submenu": "spDebug.submenu",
          "when": "resourceExtname == .sql",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "spDebug.openInWorkbench",
          "when": "resourceLangId == sql",
          "group": "navigation@9"
        },
        {
          "submenu": "spDebug.submenu",
          "when": "resourceLangId == sql",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "spDebug.submenu",
          "when": "resourceLangId == sql",
          "group": "navigation"
        }
      ]
    },
    "configuration": [
      {
        "title": "SQL Debug Harness › Generate",
        "order": 0,
        "properties": {
          "spDebug.traceStyle": {
            "type": "string",
            "enum": [
              "select",
              "print",
              "printCombined",
              "raiserror"
            ],
            "enumDescriptions": [
              "SELECT 'DBG' [NOTES], @var [var], … (default)",
              "One PRINT per variable after each assignment",
              "Single PRINT with all variables from the same assignment combined",
              "RAISERROR … WITH NOWAIT (Messages tab in SSMS)"
            ],
            "default": "select",
            "order": 1,
            "description": "How variable traces are emitted in generated debug scripts."
          }
        }
      },
      {
        "title": "SQL Debug Harness › Workbench",
        "order": 2,
        "properties": {
          "spDebug.workbenchToolbarStyle": {
            "type": "string",
            "enum": [
              "iconsAndText",
              "iconsOnly",
              "textOnly"
            ],
            "enumDescriptions": [
              "Show icons and labels on workbench toolbar buttons",
              "Show icons only (labels appear as tooltips)",
              "Show text labels only"
            ],
            "default": "iconsAndText",
            "order": 1,
            "description": "How workbench toolbar buttons are displayed."
          }
        }
      },
      {
        "title": "SQL Debug Harness › Logging",
        "order": 1,
        "properties": {
          "spDebug.logToOutput": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "markdownDescription": "Write the step-by-step transform/analyze log to the **SQL Debug Harness** output channel."
          },
          "spDebug.saveLogFile": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "description": "Also save the step log as <procedure>.log beside the source .sql file (when saved on disk)."
          },
          "spDebug.quietWhenLogging": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "When step logging is enabled, avoid duplicating progress lines in the Output channel."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "check": "tsc -p ./ --noEmit",
    "watch": "node esbuild.js --watch",
    "test": "jest",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && mkdir -p dist && vsce package --out dist/sql-debug-harness.vsix",
    "publish": "bash scripts/publish-marketplace.sh",
    "publish:dry-run": "bash scripts/publish-marketplace.sh --dry-run",
    "docs:build": "bash scripts/build-docs.sh",
    "docs:pdf": "bash scripts/build-docs.sh --pdf",
    "docs:serve": "npm run docs:build && npx --yes serve docs -p 8080"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "2.32.0",
    "esbuild": "^0.28.1",
    "jest": "^30.4.2",
    "md-to-pdf": "^5.2.4",
    "sass": "^1.77.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "node-sql-parser": "^5.4.0"
  }
}
